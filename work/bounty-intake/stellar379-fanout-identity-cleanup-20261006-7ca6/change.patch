+    /// Removes only entries still pointing to the supplied connection instances.
+    /// Comparison and removal share one write lock so replacements cannot intervene.
+    pub(crate) async fn remove_batch_if_current(
+        &self,
+        connections: &[Arc<Connection>],
+    ) -> Vec<ConnectionId> {
+        let mut removed_ids = Vec::new();
+        let mut guard = self.connections.write().await;
+        for connection in connections {
+            let is_current = guard
+                .get(&connection.id)
+                .map(|current| Arc::ptr_eq(current, connection))
+                .unwrap_or(false);
+            if is_current {
+                guard.remove(&connection.id);
+                removed_ids.push(connection.id.clone());
+            }
+        }
+        removed_ids
+    }
